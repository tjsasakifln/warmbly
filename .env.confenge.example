# CONFENGE local-first operator env (NO real secrets).
# Copy to .env.confenge (gitignored) and edit values for your machine:
#   cp .env.confenge.example .env.confenge
#
# Then: make confenge-local
# Preflight: make confenge-preflight
#
# Fail-closed defaults are intentional. Do not flip AUTO_SEND on.

# ─── Master switches (local demo path) ───────────────────────────────────
CONFENGE_OUTREACH_ENABLED=true
CONFENGE_REQUIRE_HUMAN_APPROVAL=true
# Global auto-send is PROHIBITED for CONFENGE commercial outreach.
CONFENGE_AUTO_SEND_ENABLED=false
# Operational kill switch (also toggled by make confenge-stop-sending).
CONFENGE_SENDING_PAUSED=false
CONFENGE_KILL_SWITCH_PATH=data/confenge-kill-switch
# Primary CONFENGE pace: global rolling-hour governor (email + WhatsApp share it).
# Target operational band is ~10 outbound/hour, NOT ~10/day.
CONFENGE_GLOBAL_SENDS_PER_HOUR=10
CONFENGE_MIN_SEND_GAP_SECONDS=360
CONFENGE_SEND_WINDOW_START=09:00
CONFENGE_SEND_WINDOW_END=18:00
# Secondary campaign-shell daily ceiling only. Must stay high enough that it does
# not silently collapse capacity to 10/day (default 100 ≈ full 09–18 day at 10/h).
# Mailbox/provider limits may still impose lower caps.
CONFENGE_DEFAULT_CAMPAIGN_DAILY_LIMIT=100
CONFENGE_MAX_INITIAL_EMAIL_WORDS=120
CONFENGE_MAX_FEED_PAYLOAD_BYTES=33554432

# ─── Intelligence feed (extra-cli) ───────────────────────────────────────
CONFENGE_EXTRA_CLI_FEED_URL=file://internal/app/confenge/testdata/demo_3_companies.json
CONFENGE_EXTRA_CLI_FEED_TOKEN=
CONFENGE_EXTRA_CLI_ALLOWED_HOSTS=
# Dynamic activation priority (shadow OFF by default). Import still stores fields.
CONFENGE_DYNAMIC_PRIORITY_ENABLED=false
# Continuous manifest sync (fail-closed OFF). Prefer HTTPS + allowlist in prod.
# When enabled, also set CONFENGE_FEED_SYNC_ORG_ID so the backend ticker has a target org.
CONFENGE_FEED_SYNC_ENABLED=false
CONFENGE_EXTRA_CLI_MANIFEST_URL=
CONFENGE_FEED_SYNC_INTERVAL=15m
CONFENGE_FEED_SYNC_ORG_ID=

# ─── Outcome loop (optional offline) ─────────────────────────────────────
CONFENGE_OUTCOME_WEBHOOK_URL=
CONFENGE_OUTCOME_WEBHOOK_SECRET=

# ─── AI (optional; template fallback when unset) ─────────────────────────
# AI may draft/classify/suggest only. Never approves or sends.
# AI_PROVIDER=ollama
# AI_API_KEY=
# AI_MODEL=
# AI_BASE_URL=
# AI_FREE=true

# ─── Email ───────────────────────────────────────────────────────────────
# Local: Mailpit SMTP sink. Seed creates SMTP/IMAP mailboxes.
# M365 OAuth and SMTP/IMAP both supported via dashboard.
# Smoke only to addresses YOU control (Mailpit or personal).

# ─── WhatsApp (official/compatible only; no Baileys in prod) ─────────────
CONFENGE_WHATSAPP_ENABLED=false
CONFENGE_WHATSAPP_AUTO_SEND_ENABLED=false
CONFENGE_WHATSAPP_AUTO_REPLY_ENABLED=false
# Offline mock: CONFENGE_WHATSAPP_ENABLED=true WHATSAPP_PROVIDER=mock
# Cloud API: WHATSAPP_PROVIDER=evolution + base URL/key/instance
WHATSAPP_EVOLUTION_ALLOW_BAILEYS=false
WHATSAPP_WEBHOOK_SECRET=
CONFENGE_CROSS_CHANNEL_MIN_INTERVAL_HOURS=24
WHATSAPP_SERVICE_WINDOW_HOURS=24

# ─── Bind / infra (confenge-local sets these) ─────────────────────────────
# APP_ENV=dev
# API_HOST=127.0.0.1:8080
# EVENTBUS_PROVIDER=nats
# NATS_URL=nats://localhost:4222
# PRIMARY_DB=postgres://warmbly:warmbly@localhost:15432/warmbly_dev?sslmode=disable
# REDIS=redis://localhost:16379
# BILLING_PROVIDER=none
# AWS_CONFIG_ENABLED=false
# CAPTCHA_PROVIDER=none
# KMS_PROVIDER=local
# BLOB_PROVIDER=filesystem
# TASKS_PROVIDER=local
