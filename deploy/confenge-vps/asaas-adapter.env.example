# Installed as /etc/confenge/asaas-adapter.env with mode 0600. No real values in Git.
# Asaas authToken: 32-255 characters, no whitespace, never an Asaas API key.
ASAAS_WEBHOOK_TOKEN=
ASAAS_ADAPTER_WARMBLY_BEARER_TOKEN=
ASAAS_ADAPTER_WARMBLY_WEBHOOK_SECRET=
ASAAS_ADAPTER_WARMBLY_WEBHOOK_SECRET_PREVIOUS=
ASAAS_ADAPTER_WARMBLY_URL=http://127.0.0.1:8080/v1/confenge/intel/commercial/provider-events
ASAAS_ADAPTER_STATE_DIR=/var/lib/confenge-asaas-adapter
ASAAS_ADAPTER_HOST=127.0.0.1
ASAAS_ADAPTER_PORT=8791
ASAAS_ADAPTER_MAX_ATTEMPTS=8
ASAAS_ADAPTER_BASE_BACKOFF_SECONDS=5
ASAAS_ADAPTER_MAX_BACKOFF_SECONDS=900
ASAAS_ADAPTER_PROCESSING_LEASE_SECONDS=120
ASAAS_ADAPTER_PROCESSED_RETENTION_DAYS=45
ASAAS_ADAPTER_BACKUP_MAX_AGE_SECONDS=93600
ASAAS_ADAPTER_DRY_RUN=false
